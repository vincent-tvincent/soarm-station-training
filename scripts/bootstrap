#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
command -v uv >/dev/null || { python3 -m venv .bootstrap; .bootstrap/bin/pip install uv; export PATH="$PWD/.bootstrap/bin:$PATH"; }
uv python install 3.12
uv venv --python 3.12 .venv
uv pip install --index-strategy unsafe-best-match --python .venv/bin/python -r requirements.lock
uv pip install --index-strategy unsafe-best-match --python .venv/bin/python -e . --no-deps
